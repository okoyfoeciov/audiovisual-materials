{
  "name": "audiovisual-materials",
  "version": "1.0.7",
  "description": "Standalone desktop media-library player, backed by a local backend (backend/), clone of comart's Listen (audio playback) feature",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "backend": "node backend/server.js",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "james <khiem.le@stanyangroup.com>",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.audiovisual-materials.app",
    "productName": "Audiovisual Materials",
    "files": [
      "main.js",
      "preload.js",
      "titlebar.js",
      "app.html",
      "app-base.js",
      "app-listen.js",
      "app-dictation.js",
      "mic.css",
      "mic.js",
      "backend/*.js",
      "*.woff2",
      "icon.svg",
      "build/icons/256x256.png"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Used by the microphone button to record short voice clips for transcription."
      }
    },
    "linux": {
      "target": "deb",
      "category": "AudioVideo",
      "icon": "build/icons"
    }
  }
}
