# systemd USER unit — fronts the loopback media-library server with HTTPS
# over the tailnet. Install AFTER confirming `tailscale status` shows
# BackendState Running.
#   cp deploy/av-materials-serve.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now av-materials-serve.service
# App is then reachable at https://nuc-15-pro.taile4fb34.ts.net/av-materials
# — a concrete path, not the bare root, so this NUC's other apps (/comart on
# 8770, /memoir on 8787, /books on 8766) share the same tailnet host without
# colliding.
[Unit]
Description=tailscale serve (HTTPS) for av-materials over tailnet
# DO NOT add `After=tailscaled.service` here. This is a USER unit and tailscaled
# is a SYSTEM unit, so a user unit cannot order itself against it: the directive
# resolves to a nonexistent *user* unit and does nothing. The ExecStartPre gate
# below is the ordering that directive could never give (see deploy/tailscale-wait.sh).
After=av-materials.service
Wants=av-materials.service
PartOf=av-materials.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStartPre=/home/james/audiovisual-materials/deploy/tailscale-wait.sh
ExecStart=/usr/bin/tailscale serve --bg --set-path /av-materials 8768
# NO ExecStop with `tailscale serve reset` — reset is node-wide and would delete
# every tailnet path on this machine, including /comart, /memoir and /books.
# Leaving the mapping in place on stop is harmless: ExecStart re-adds it
# idempotently. To clear everything deliberately, run `tailscale serve reset`.
TimeoutStartSec=180

[Install]
WantedBy=default.target
